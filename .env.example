# Le site n'a aucune base de données : il s'appuie sur des API tierces.

# Formulaire de contact : API qui reçoit le message (service d'e-mail, CRM, tickets…).
# Reçoit un POST JSON : source, receivedAt, name, email, phone, consulate, topic, message, locale.
CONTACT_API_URL=
CONTACT_API_KEY=      # facultatif : envoyé en "Authorization: Bearer <clé>"
