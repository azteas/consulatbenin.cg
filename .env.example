DATABASE_URL="postgresql://postgres:postgres@localhost:5433/consulat_benin"
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

# Notification e-mail du formulaire de contact (facultatif).
# Sans ces variables, les messages sont quand même enregistrés en base (table contact_messages).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=            # mot de passe d'application, jamais le mot de passe du compte
SMTP_FROM="Consulat du Bénin <adresse@exemple.com>"
CONTACT_TO=           # facultatif : force le destinataire ; sinon l'e-mail du consulat choisi
